root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown keeps one line per paragraph and list item; trailing double spaces are never used for breaks.
max_line_length = off

[scripts/hooks/*]
indent_size = 4

[*.eml]
# Mail fixtures stay byte-exact.
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false
