{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    // A module a Node script also runs (src/meta/client.ts, by scripts/meta-client-live.ts) names its imports with
    // their extension, the only form Node's type stripping resolves; Wrangler's bundler takes either.
    "allowImportingTsExtensions": true,
    // The lookalike module's generated Unicode data (src/checks/confusables-map.json, D02 T03 §1).
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["./worker-configuration.d.ts"],
    // WORKAROUND: @cloudflare/puppeteer 1.4.0's declarations name DOM types (Node, HTMLElementTagNameMap) and repeat
    // globals the Workers runtime types already declare, which the DOM library would conflict with further; library
    // declarations are not checked, while every file of ours still is, against them.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"]
}
