{
  "name": "isitlegit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD)",
