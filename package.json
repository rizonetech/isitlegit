{
  "name": "isitlegit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD)",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/node && tsc --noEmit -p tsconfig.config.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build:css": "node scripts/build-css.ts",
    "build:assets": "python3 design/tools/build-webfonts.py && pnpm build:css && node scripts/hash-asset.ts",
    "build": "wrangler deploy --dry-run --outdir build/dry",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:auth-schema": "node scripts/auth-schema.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "better-auth": "1.7.13",
    "hono": "4.13.14",
    "opus-decoder": "0.7.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@breezystack/lamejs": "1.2.7",
    "@cloudflare/vitest-plugin": "1.4.8",
    "@meta-sam/parser": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "openai": "7.43.0",
    "opusscript": "0.1.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
