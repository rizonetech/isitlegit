{
  "name": "isitlegit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD) --var ENV:development",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/node && tsc --noEmit -p tsconfig.config.json",
    "lint": "biome check .",
    "test": "vitest run",
    "eval:run": "node eval/run.ts",
    "eval:metrics": "node eval/metrics.ts",
    "eval:baseline": "node eval/baseline.ts",
    "test:a11y": "A11Y=1 vitest run --project a11y",
    "build:css": "node scripts/build-css.ts",
    "deploy:site": "pnpm --filter site run deploy",
    "build:assets": "python3 design/tools/build-webfonts.py && pnpm build:css && node scripts/hash-asset.ts",
    "build": "wrangler deploy --dry-run --outdir build/dry",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:auth-schema": "node scripts/auth-schema.ts",
    "eval:ablate": "node eval/ablate-run.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.13",
    "@cloudflare/puppeteer": "1.4.0",
    "@kenjiuno/msgreader": "1.29.0",
    "@simplewebauthn/server": "14.0.3",
    "better-auth": "1.7.13",
    "hono": "4.13.14",
    "htmx.org": "2.0.11",
    "opus-decoder": "0.7.12",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.2.0",
    "tldts": "7.4.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@breezystack/lamejs": "1.2.7",
    "@cloudflare/vitest-plugin": "1.4.8",
    "@meta-sam/parser": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "axe-core": "4.11.4",
    "cfb": "1.2.2",
    "openai": "7.53.0",
    "opusscript": "0.1.1",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
