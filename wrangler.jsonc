{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isitlegit",
  "main": "src/index.ts",
  // WORKAROUND: the voice decoder's dependency needs a Web Worker class at import, which a Worker lacks; see
  // src/voice/no-web-worker.ts. vitest.config.ts names the same alias (test/node/opus-wasm.test.ts checks they agree).
  "alias": { "@eshaz/web-worker": "./src/voice/no-web-worker.ts" },
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // The PDF library and its worker, read as text and injected into the Browser Run page (D03 T02 §2).
  "rules": [
    {
      "type": "Text",
      "globs": ["**/pdf.min.mjs", "**/pdf.worker.min.mjs", "**/fixtures/**/*.html", "**/axe.min.js"],
      "fallthrough": false
    },
    {
      "type": "Data",
      "globs": ["**/pdfjs-dist/wasm/openjpeg.wasm", "**/pdfjs-dist/wasm/jbig2.wasm", "**/pdf-cmaps.bin"],
      "fallthrough": true
    }
  ],
  // The app's own host (D07 T06 §9): the links it mails name it (APP_URL, PUBLIC_ORIGIN). workers.dev stays on for
  // scripts/smoke.ts, which sends its token only to isitlegit.derick-f5a.workers.dev or this host (D00 T01 §5).
  "routes": [
    { "pattern": "app.isitlegit.co.za", "custom_domain": true },
    // The public trust paths on the apex (D07 T06 §20): the verify page, the seal frame and the badge image are
    // served by this Worker, while the rest of isitlegit.co.za is the static site (isitlegit-site).
    { "pattern": "isitlegit.co.za/v/*", "zone_name": "isitlegit.co.za" },
    { "pattern": "isitlegit.co.za/s/*", "zone_name": "isitlegit.co.za" },
    { "pattern": "isitlegit.co.za/b/*", "zone_name": "isitlegit.co.za" },
    { "pattern": "isitlegit.co.za/static/*", "zone_name": "isitlegit.co.za" },
    // www answers only the permanent redirect to the apex, answered in src/index.ts (D07 T06 §20); the custom
    // domain makes the DNS record and certificate the zone Redirect Rule would have needed.
    { "pattern": "www.isitlegit.co.za", "custom_domain": true },
    // The redirect fixtures (D02 T07 §2): served by this Worker under a secret path prefix; the custom domain makes the DNS record.
    { "pattern": "fixtures.isitlegit.co.za", "custom_domain": true }
  ],
  "workers_dev": true,
  // Fingerprinted stylesheet and fonts (D07 T01 §5); public/_headers gives /static/* a year-long immutable cache.
  "assets": { "directory": "./public" },
  // IsItLegit's own resources (D00 T01 §5), created under the operator's standing authorisation (AGENTS.md).
  // Cases, tenants and every other record.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isitlegit",
      "database_id": "7a393f34-f8be-4ba6-b0a8-fce35a34a0e7",
      // The schema's history (D01 T01 §1); `pnpm db:migrate:local` and `pnpm db:migrate:remote` apply it.
      "migrations_dir": "src/db/migrations"
    }
  ],
  // Raw mail and attachments under raw/ (deleted after 30 days by the bucket's lifecycle rule, POPIA) and derived
  // artefacts under art/.
  "r2_buckets": [{ "binding": "ARTEFACTS", "bucket_name": "isitlegit-artefacts" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "ea28d6e83ede4a83bfb06898d8791a16" }],
  // The analysis pipeline (D02 onwards); a no-op step until then.
  "workflows": [
    { "name": "isitlegit-analysis", "binding": "ANALYSIS", "class_name": "AnalysisWorkflow" },
    // The impersonation monitor's daily run, one instance per organisation per day (D05 T04 §2).
    { "name": "isitlegit-monitor", "binding": "MONITOR", "class_name": "MonitorWorkflow" }
  ],
  // Browser Run, driven by @cloudflare/puppeteer.
  "browser": { "binding": "BROWSER" },
  // Workers AI and AI Gateway: the Worker reaches the authenticated `isitlegit` gateway through this binding, which
  // is pre-authenticated, so it stores no gateway token (D00 T01 §6).
  "ai": { "binding": "AI" },
  // The Worker's own version id, which the smoke route reports so a run proves the exact version it tested.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // Local default; `wrangler dev --var` and the deploy (`--var COMMIT_SHA:$(git rev-parse HEAD)`) override it.
    "COMMIT_SHA": "dev",
    // The Meta Model API through AI Gateway's `meta` custom provider; the client appends /responses and the rest.
    "META_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f5a529987f8dc7d52ce7aba3da25e226/isitlegit/custom-meta/v1",
    // Loupe's dedicated Fireworks deployment through AI Gateway's `fireworks` custom provider (D03 T04 §1, §15); the
    // screener appends /chat/completions. Its key is the secret FIREWORKS_API_KEY (vault "IsItLegit Fireworks").
    // Loupe is disabled after failed qualification; production screening goes directly to Spark.
    "LOUPE_ENABLED": "false",
    "GLIMMER_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f5a529987f8dc7d52ce7aba3da25e226/isitlegit/custom-fireworks/v1",
    // The operator's mailbox (design spec section 11): alerts and unresolved sends go here (D01 T02 §5, §2).
    "OPERATOR_EMAIL": "hostmaster@rizonetech.com",
    // A second copy of each forwarding-failure alert, on another provider, since OPERATOR_EMAIL is the aliases' own
    // destination (D01 T02 §6, operator decision 2026-10-30).
    "OPERATOR_FALLBACK_EMAIL": "rizonetech@gmail.com",
    // The eval organisation (D01 T01 §22): replay-scoped intake claims are honoured only for this organisation.
    // An identifier, not a secret; empty until the coordinator sets it at the section's gate.
    "EVAL_ORG_ID": "hyVHVbGUx1OTWhfzaqIwMOfpig6xGDnc",
    // The admin console's Access application (D07 T05 §1): its audience tag and the Zero Trust team domain the
    // Worker verifies Cf-Access-Jwt-Assertion against; identifiers, not secrets. CF_ACCESS_EMAIL is the operator's
    // own sign-in address, the second address the Access policy admits beside OPERATOR_EMAIL.
    "CF_ACCESS_AUD": "c3416dd9f091aed63007327c96d2337b422ebfa19a2141814314f258edf37a85",
    "CF_ACCESS_TEAM_DOMAIN": "floral-brook-905a.cloudflareaccess.com",
    "CF_ACCESS_EMAIL": "derick@rizonetech.com",
    // isitlegit.co.za's zone, whose Email Routing events the forwarding check reads (D01 T02 §6).
    "EMAIL_ZONE_ID": "88aeec6df134bc59bfa16a25751241ef",
    // The app's own origin: Better Auth's base URL, the origin its cookies and its origin check rely on (D07 T02 §1).
    "APP_URL": "https://app.isitlegit.co.za",
    // The origin the reply's report links are made absolute with (D01 T02 §3): the app's own, and https only. Separate
    // from APP_URL because the tests serve the app at http://localhost and need an https origin here.
    "PUBLIC_ORIGIN": "https://app.isitlegit.co.za",
    // Planned downtime: empty means normal. "<start ISO>/<end ISO>" (for example "2026-10-28T00:00:00Z/2026-10-28T00:30:00Z")
    // makes every request but /static/ answer the maintenance page with that window; any other text does so with no
    // window (D07 T08 §1). Email Routing is not affected.
    "MAINTENANCE": "",
    // `development` only under `pnpm dev` (`--var ENV:development`): the component gallery (D07 T01 §10) answers 404
    // everywhere else, deploys included.
    "ENV": "production"
  },
  // Every 15 minutes: settle uncertain mail sends from SMTP2GO's record (D01 T02 §5, src/mail/reconcile.ts).
  // Every 15 minutes, the scheduled work; every minute, only the retry sweep (D01 T01 §17); every five minutes between
  // the quarter-hours, only the forwarding check (D01 T02 §12); dispatched on the cron string in src/index.ts.
  "triggers": { "crons": ["*/15 * * * *", "* * * * *", "5,10,20,25,35,40,50,55 * * * *", "15 4 * * *"] }
}
