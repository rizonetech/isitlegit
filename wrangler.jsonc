{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isitlegit",
  "main": "src/index.ts",
  // WORKAROUND: the voice decoder's dependency needs a Web Worker class at import, which a Worker lacks; see
  // src/voice/no-web-worker.ts. vitest.config.ts names the same alias (test/node/opus-wasm.test.ts checks they agree).
  "alias": { "@eshaz/web-worker": "./src/voice/no-web-worker.ts" },
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // The app's own host (D07 T06 §9): the links it mails name it (APP_URL, PUBLIC_ORIGIN). workers.dev stays on for
  // scripts/smoke.ts, which sends its token only to isitlegit.derick-f5a.workers.dev or this host (D00 T01 §5).
  "routes": [{ "pattern": "app.isitlegit.co.za", "custom_domain": true }],
  "workers_dev": true,
  // Fingerprinted stylesheet and fonts (D07 T01 §5); public/_headers gives /static/* a year-long immutable cache.
  "assets": { "directory": "./public" },
  // IsItLegit's own resources (D00 T01 §5), created under the operator's standing authorisation (AGENTS.md).
  // Cases, tenants and every other record.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isitlegit",
      "database_id": "7a393f34-f8be-4ba6-b0a8-fce35a34a0e7",
      // The schema's history (D01 T01 §1); `pnpm db:migrate:local` and `pnpm db:migrate:remote` apply it.
      "migrations_dir": "src/db/migrations"
    }
  ],
  // Raw mail and attachments under raw/ (deleted after 30 days by the bucket's lifecycle rule, POPIA) and derived
  // artefacts under art/.
  "r2_buckets": [{ "binding": "ARTEFACTS", "bucket_name": "isitlegit-artefacts" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "ea28d6e83ede4a83bfb06898d8791a16" }],
  // The analysis pipeline (D02 onwards); a no-op step until then.
  "workflows": [{ "name": "isitlegit-analysis", "binding": "ANALYSIS", "class_name": "AnalysisWorkflow" }],
  // Browser Run, driven by @cloudflare/puppeteer.
  "browser": { "binding": "BROWSER" },
  // Workers AI and AI Gateway: the Worker reaches the authenticated `isitlegit` gateway through this binding, which
  // is pre-authenticated, so it stores no gateway token (D00 T01 §6).
  "ai": { "binding": "AI" },
  // The Worker's own version id, which the smoke route reports so a run proves the exact version it tested.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // Local default; `wrangler dev --var` and the deploy (`--var COMMIT_SHA:$(git rev-parse HEAD)`) override it.
    "COMMIT_SHA": "dev",
    // The Meta Model API through AI Gateway's `meta` custom provider; the client appends /responses and the rest.
    "META_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f5a529987f8dc7d52ce7aba3da25e226/isitlegit/custom-meta/v1",
    // The operator's mailbox (design spec section 11): alerts and unresolved sends go here (D01 T02 §5, §2).
    "OPERATOR_EMAIL": "hostmaster@rizonetech.com",
    // The app's own origin: Better Auth's base URL, the origin its cookies and its origin check rely on (D07 T02 §1).
    "APP_URL": "https://app.isitlegit.co.za",
    // The origin the reply's report links are made absolute with (D01 T02 §3): the app's own, and https only. Separate
    // from APP_URL because the tests serve the app at http://localhost and need an https origin here.
    "PUBLIC_ORIGIN": "https://app.isitlegit.co.za",
    // Empty: no fault. D01 T01 §9's live check deploys it once (`--var INTAKE_FAULT_SENDER:<the test sender>`) to make
    // the raw store fail for that one sender's forwards only, and redeploys without it after.
    "INTAKE_FAULT_SENDER": ""
  },
  // Every 15 minutes: settle uncertain mail sends from SMTP2GO's record (D01 T02 §5, src/mail/reconcile.ts).
  "triggers": { "crons": ["*/15 * * * *"] }
}
