#!/bin/sh
# Refuse a commit that would turn the plan gates red: one that stages TODO changes while todo/implementation-plan.md
# is stale or the TODO graph is invalid. Enabled per clone with `git config core.hooksPath scripts/hooks`.
# Ticking a checklist item changes the generated plan, so every TODO edit needs `plan --sync`.
# Receipts and findings files are graph evidence too: a commit touching only docs/reviews/ is checked as well.
# Client names never enter the public repository. samples/client-names.txt (git-ignored, one name, domain or address
# per line) lists them; a commit is refused while the index (what the commit records) holds one, in any case, in a
# file's content or its path. The whole index is scanned, not a diff: a diff hides binary-marked files ("Binary files
# differ") and its "+++" headers look like content lines that start with "++". Paths are read with core.quotePath off,
# because git otherwise escapes non-ASCII bytes (`Café` becomes `Caf\303\251`) and the name would not match. Blank
# lines are dropped first: an empty pattern would match every line. Font and raster image files are not read as
# text: their bytes carry no words anyone writes a name into, and a short name (three letters) matches them by chance;
# their paths are still checked, and mail fixtures and PDFs are still read as text. scripts/check-publication.py runs
# the same scan before a push.
names_file="$(git rev-parse --show-toplevel)/samples/client-names.txt"
if [ -f "$names_file" ]; then
    # Fail closed: a list that exists but cannot be read, or a scan that errors, refuses the commit rather than
    # passing it unchecked (git grep and grep exit 1 for "no match" and above 1 for an error).
    patterns=$(mktemp) || exit 1
    if ! sed -e 's/\r$//' -e '/^[[:space:]]*$/d' "$names_file" > "$patterns"; then
        rm -f "$patterns"
        echo "pre-commit: samples/client-names.txt exists but cannot be read; fix its permissions" >&2
        exit 1
    fi
    if [ -s "$patterns" ]; then
        git grep --cached -q -a -i -F -f "$patterns" -- . ':(exclude,glob)**/*.ttf' ':(exclude,glob)**/*.otf' ':(exclude,glob)**/*.woff' ':(exclude,glob)**/*.woff2' ':(exclude,glob)**/*.png' ':(exclude,glob)**/*.jpg' ':(exclude,glob)**/*.jpeg' ':(exclude,glob)**/*.gif' ':(exclude,glob)**/*.webp' ':(exclude,glob)**/*.ico'
        content=$?
        git -c core.quotePath=false ls-files > "$patterns.paths" && grep -q -i -F -f "$patterns" "$patterns.paths"
        paths=$?
        rm -f "$patterns" "$patterns.paths"
        if [ "$content" -eq 0 ] || [ "$paths" -eq 0 ]; then
            echo "pre-commit: the staged tree contains a client name from samples/client-names.txt; anonymise it" >&2
            exit 1
        fi
        if [ "$content" -ne 1 ] || [ "$paths" -ne 1 ]; then
            echo "pre-commit: the client-name scan failed, so the commit is refused unchecked; run it again" >&2
            exit 1
        fi
    else
        rm -f "$patterns"
    fi
fi

# Private machine paths (a home folder, a Windows or WSL-mounted user folder) never enter the public repository either:
# the pattern scripts/check-publication.py uses, over the whole index, so a reviewer's quoted path in a findings file is
# caught before it is committed, not after a push. Test fixtures may hold examples.
git grep --cached -q -E -e '/home/[a-z]|[A-Z]:\\(GitHub|Users)\\[A-Za-z]|/mnt/[a-z]/(GitHub|Users)/[A-Za-z]' -- . ':!tests/' ':!scripts/tests/'
private=$?
if [ "$private" -eq 0 ]; then
    echo "pre-commit: the staged tree contains a private path (a home or user folder); write it with ~ or a placeholder (python3 scripts/check-publication.py names the line)" >&2
    exit 1
fi
if [ "$private" -ne 1 ]; then
    echo "pre-commit: the private-path scan failed, so the commit is refused unchecked; run it again" >&2
    exit 1
fi

git diff --cached --name-only -- todo/ docs/reviews/ | grep -q . || exit 0

# The check reads the working tree, so the TODO files and the review receipts and findings they cite
# (docs/reviews/) must be exactly what is being committed: nothing unstaged and nothing untracked, ignored files
# included, since the check reads those too.
for dir in todo/ docs/reviews/; do
    if ! git diff --quiet -- "$dir" || [ -n "$(git ls-files --others -- "$dir")" ]; then
        echo "pre-commit: $dir has unstaged or untracked changes; stage them (or stash them) so the plan check sees what is committed" >&2
        exit 1
    fi
done

root=$(git rev-parse --show-toplevel) || exit 1
# The first interpreter that actually runs: on Windows `python3` can be the Microsoft Store stub.
python=
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "" >/dev/null 2>&1; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo "pre-commit: Python is needed to check the TODO graph" >&2
    exit 1
fi
if ! "$python" "$root/scripts/todo-graph.py" validate >/dev/null || ! "$python" "$root/scripts/todo-graph.py" plan --check; then
    echo "pre-commit: run 'python scripts/todo-graph.py plan --sync', stage todo/implementation-plan.md, and commit again" >&2
    exit 1
fi
