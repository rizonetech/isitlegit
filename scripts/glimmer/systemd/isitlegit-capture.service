[Unit]
Description=Is It Legit day-zero case capture (private, read-only against production)
StartLimitIntervalSec=21600
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=%h/isitlegit-loupe
Environment=PATH=%h/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/isitlegit-loupe/scripts/glimmer/capture-run.sh
# A deferred (75) or failed run is tried again, a bounded number of times.
Restart=on-failure
RestartSec=900
RestartForceExitStatus=75
Nice=15
