---
// Protect your business (design/SPEC.md S4, board ProtectSite; D07 T06 §7). Every protection renders through the claims
// registry, the examples are fictional (.example), and what is only planned says so.
import Claim from "../components/Claim.astro";
import Seal from "../components/Seal.astro";
import Base from "../layouts/Base.astro";
import badge from "../../../design/brand/logo-svg/isitlegit-badge-protected.svg";
import { button, CARD, LINK, PILL } from "../lib/classes.ts";
import type { ClaimId } from "../lib/claims.ts";
import { app, demoVerify, HELLO_ADDRESS, inviteRequest, site } from "../lib/links.ts";
import { SABRIC_2025 } from "../lib/sources.ts";

const lookalikes: [string, string, string, "mal" | "sus" | "neutral", string][] = [
  ["fynbos-freight.example", "Today", "Login form", "mal", `${PILL} bg-mal-wash text-mal`],
  ["fynbosfreight-pay.example", "Yesterday", "Parked", "sus", `${PILL} bg-sus-wash text-sus`],
  ["fynb0sfreight.example", "21 Oct", "Not live", "neutral", `${PILL} bg-surface border border-line text-ink-2`],
];
const blocks: { n: string; id: string; kicker: string; title: string; claim: ClaimId }[] = [
  { n: "1", id: "identity", kicker: "Protected identity", title: "Register who you really are", claim: "protect.identity" },
  { n: "2", id: "seal", kicker: "Website seal", title: "A seal that only works on your website", claim: "protect.seal" },
  { n: "3", id: "badge", kicker: "Signature badge", title: "A badge that turns copies into evidence", claim: "protect.badge" },
  { n: "4", id: "monitor", kicker: "Impersonation monitor", title: "Find the fake website before the fake email", claim: "protect.monitor" },
  { n: "5", id: "bank", kicker: "Bank verification", title: "Changed bank details get confirmed by you", claim: "protect.bank" },
];
const BADGE_ALT = "Protected by IsItLegit signature badge";
---

<Base
  title="Protect your business: who protects your name?"
  description="IsItLegit Protect compares mail that claims to be your business with what you registered, and watches for lookalike websites. Free for 14 days during the launch."
>
  <section aria-labelledby="protect-title" data-region="intro" class="site-container grid gap-48 py-48 md:py-80 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div class="flex flex-col gap-24">
      <p class="type-eyebrow text-orange-text">Protect your business</p>
      <h1 id="protect-title" class="type-h1 md:type-display">Who protects your name when a scammer uses it?</h1>
      <p class="text-18 md:text-20 text-ink-2 max-w-text">
        Email security protects the people receiving mail. Your own mail filter never sees an email a scammer sends to your
        customers or suppliers in your name. <Claim id="protect.answer" /> A fake that nobody forwards and no
        lookalike site shows, we do not see.
      </p>
      <p data-invite class="type-small text-muted">
        Members join with an invite code during the launch. No invite code? <a href={inviteRequest} class={LINK}>Ask for one at {HELLO_ADDRESS}</a>.
      </p>
      <div class="flex flex-col gap-12 sm:flex-row">
        <a href={app.signup} class={button.primary}>Protect my business</a>
        <a href={demoVerify} class={button.ghost}>See a verify page</a>
      </div>
      <p data-byline class="type-small text-muted">By Derick Payne, Rizonetech · Reviewed 31 Oct 2026</p>
    </div>
    <div data-region="hero-art" class="flex flex-col items-center gap-24">
      <Seal alt="The IsItLegit Protected seal" />
      <img src={badge.src} width={badge.width} height={badge.height} alt={BADGE_ALT} class="h-56 w-auto" />
    </div>
  </section>

  <section aria-labelledby="why-title" data-region="why" class="bg-subtle border-y border-line">
    <div class="site-container grid gap-40 py-56 md:py-80 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col gap-16 min-w-0">
        <h2 id="why-title" class="type-h2 md:type-h1">Why did we build this?</h2>
        <p class="text-18 text-ink-2">
          At one of our clients, a criminal emailed a supplier's courier while pretending to be that supplier and asked for
          its statement. The supplier's own mail filter never saw the email, because it never reached the supplier. We tell
          the story here with a fictional name: Fynbos Freight. It is not rare: SABRIC's 2025 report names supplier mandate
          fraud and business email compromise as material risks for businesses (<a href={SABRIC_2025.url} class={`${LINK} wrap-anywhere`}>SABRIC {SABRIC_2025.title}</a>, page 9).
        </p>
      </div>
      <figure data-region="story-email" class={`${CARD} shadow-card m-0 p-24 flex flex-col gap-12 min-w-0`}>
        <dl class="grid grid-cols-[auto_1fr] gap-x-16 gap-y-4 m-0 type-small">
          <dt class="text-muted">From</dt><dd class="m-0 wrap-anywhere">Fynbos Freight Accounts &lt;fynbosfreight.accounts@webmail.example&gt;</dd>
          <dt class="text-muted">To</dt><dd class="m-0 wrap-anywhere">accounts@karoocouriers.example</dd>
          <dt class="text-muted">Subject</dt><dd class="m-0">Please send our latest statement</dd>
        </dl>
        <p class="rounded-card bg-mal-wash p-12 type-small weight-text-strong text-mal">Not from Fynbos Freight</p>
        <figcaption class="type-small text-muted">Fynbos Freight is protected and only sends from fynbosfreight.example.</figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="gives-title" data-region="gives" class="site-container flex flex-col gap-48 py-56 md:py-96">
    <div class="flex flex-col gap-12 max-w-quote">
      <h2 id="gives-title" class="type-h2 md:type-h1">What does Protect give you?</h2>
      <p class="text-18 text-ink-2">Five protections that work together. Each one is evidence the investigator uses when mail claims to be you.</p>
    </div>
    {
      blocks.map((block) => (
        <article data-block={block.id} class={`${CARD} p-28 grid gap-32 lg:grid-cols-2 lg:items-center`}>
          <div class="flex flex-col gap-12 min-w-0">
            <span data-block-pill class={`${PILL} self-start bg-orange-wash text-orange-text`}>{block.n} · {block.kicker}</span>
            <h3 class="type-h2">{block.title}</h3>
            <Claim id={block.claim} as="p" class="text-ink-2" />
            {block.id === "monitor" && (
              <p data-planned class="type-small text-muted">Planned: we will also watch new certificates that use your name.</p>
            )}
          </div>
          <div class="flex flex-col gap-12 min-w-0" data-example={block.id}>
            {block.id === "identity" && (
              <ul class="rounded-card bg-subtle border border-line p-20 flex flex-col gap-12 list-none m-0 type-small">
                <li class="border-b border-line pb-8 wrap-anywhere"><span class={`${PILL} bg-safe-wash text-safe mr-8`}>Verified</span>fynbosfreight.example, mail.fynbosfreight.example</li>
                <li class="border-b border-line pb-8"><span class={`${PILL} bg-safe-wash text-safe mr-8`}>Registered</span>Logo, used by SAM 3.1 to compare logos</li>
                <li><span class={`${PILL} bg-safe-wash text-safe mr-8`}>Registered</span>Bank account, never shown to anyone</li>
              </ul>
            )}
            {block.id === "seal" && (
              <div class="grid gap-16 sm:grid-cols-2">
                <div data-panel="real" class="rounded-card bg-subtle border border-line p-16 flex flex-col items-center gap-12">
                  <span class="type-tiny font-mono text-muted wrap-anywhere">fynbosfreight.example</span>
                  <Seal alt="Seal shown on the real domain" class="size-120" />
                  <span class="type-tiny weight-text-strong text-safe">Shown, 26 Oct 2026</span>
                </div>
                <div data-panel="blocked" class="rounded-card bg-subtle border border-line p-16 flex flex-col items-center gap-12">
                  <span class="type-tiny font-mono text-muted wrap-anywhere">fynbos-freight.example</span>
                  <div data-blocked-circle class="size-120 rounded-pill border-2 border-dashed border-line-strong flex items-center justify-center text-center p-12 type-tiny text-muted">
                    Blocked by the browser
                  </div>
                  <span class="type-tiny weight-text-strong text-mal">You get an alert</span>
                </div>
              </div>
            )}
            {block.id === "badge" && (
              <div class="rounded-card bg-subtle border border-line p-20 flex flex-col gap-12 type-small">
                <p class="m-0">Kind regards,<br />Lindiwe Mokoena · Accounts, Fynbos Freight<br />accounts@fynbosfreight.example · fynbosfreight.example</p>
                <img src={badge.src} width={badge.width} height={badge.height} alt="Protected by IsItLegit badge in an email signature" class="h-48 w-auto self-start" />
              </div>
            )}
            {block.id === "monitor" && (
              <div class="rounded-card bg-subtle border border-line overflow-hidden">
                <table class="w-full border-collapse type-small">
                  <thead><tr><th scope="col" class="text-left type-label text-muted py-12 px-16 border-b border-line-strong">Lookalike</th><th scope="col" class="text-left type-label text-muted py-12 px-16 border-b border-line-strong">Found</th><th scope="col" class="text-left type-label text-muted py-12 px-16 border-b border-line-strong">Status</th></tr></thead>
                  <tbody>
                    {lookalikes.map(([domain, found, status, tone, pillClass]) => (
                      <tr>
                        <th scope="row" class="text-left font-mono weight-text-medium py-12 px-16 border-b border-line">{domain}</th>
                        <td class="py-12 px-16 border-b border-line">{found}</td>
                        <td class="py-12 px-16 border-b border-line"><span data-status-pill={tone} class={pillClass}>{status}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {block.id === "bank" && (
              <div class="rounded-card bg-subtle border border-line p-20 flex flex-col gap-12">
                <p data-illustration-text class="sr-only">
                  Illustration of the finance contact's request. Did Fynbos Freight change its bank account? An invoice in your
                  name lists an account that does not match your registered one. The two answers are No, this is not us, and
                  Yes, we changed it.
                </p>
                <div aria-hidden="true" data-illustration class="flex flex-col gap-12">
                  <p class="m-0 weight-text-strong">Did Fynbos Freight change its bank account?</p>
                  <p class="m-0 type-small text-muted">An invoice in your name lists an account that does not match your registered one.</p>
                  <div class="flex flex-wrap gap-8">
                    <span class={`${PILL} h-40 px-16 bg-surface border border-line-strong text-ink`}>No, this is not us</span>
                    <span class={`${PILL} h-40 px-16 bg-surface border border-line-strong text-ink`}>Yes, we changed it</span>
                  </div>
                </div>
                <p data-caption class="type-tiny text-muted m-0">An illustration: the real request is answered by email reply.</p>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="cost-title" data-region="closing" class="bg-orange-wash border-t border-line">
    <div class="site-container flex flex-col gap-32 py-56 md:py-80 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-col gap-12 max-w-quote">
        <h2 id="cost-title" class="type-h2 md:type-h1 text-ink">What does it cost?</h2>
        <p class="text-18 text-ink-2">
          Protect is free for 14 days during the launch. After launch it starts at R499 per organisation per month. Checking
          mail stays free for the people who receive it. I checked the trial length in our own code on 31 October 2026.
        </p>
        <p data-invite class="type-small text-muted">
          Members join with an invite code during the launch. No invite code? <a href={inviteRequest} class={LINK}>Ask for one at {HELLO_ADDRESS}</a>.
        </p>
      </div>
      <div class="flex flex-col gap-12 sm:flex-row lg:shrink-0">
        <a href={app.signup} class={button.primary}>Protect my business</a>
        <a href={site.pricing} class={button.ghost}>See pricing</a>
      </div>
    </div>
  </section>
</Base>
