{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The marketing site (D07 T06 §6): its own Worker serving the built pages as static assets on the apex. The app is
  // another Worker (../wrangler.jsonc, app.isitlegit.co.za); the coordinator owns that file, the zone's redirect rule
  // from www to the apex and the apex routes for /v/*, /s/* and /b/* (§20).
  "name": "isitlegit-site",
  "compatibility_date": "2026-10-26",
  // An unknown address gets dist/404.html (the nearest 404.html) with status 404 (D07 T08 §9).
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "isitlegit.co.za", "custom_domain": true }]
}
