{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/vitest-plugin/types"],
    // WORKAROUND: Vitest's bundled tinybench types declare an EventTarget subclass the Workers runtime types reject
    // (TS2416). Only the tests skip library checks; the root tsconfig.json still checks them for the Worker.
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../worker-configuration.d.ts"]
}
